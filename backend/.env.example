# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://ministatus:ministatus@localhost:5432/ministatus?schema=public"

# HTTP port the backend listens on
PORT=3000

# development | production | test
NODE_ENV=development

# Freely settable version tag, surfaced by GET /api/runtime.
# In Kubernetes this is typically set to the image tag / git SHA.
APP_VERSION=1.0.0

# Comma-free single origin (or "*") allowed to call the API from the browser
CORS_ORIGIN=http://localhost:5173
